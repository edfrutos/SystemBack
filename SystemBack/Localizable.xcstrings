    },
    "The backup is downloaded to the destination folder first. Files from %@ will be copied into %@. Files with different content are moved to the Trash first. Files that aren’t in the backup are left as they are.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup is downloaded to the destination folder first. Files from %1$@ will be copied into %2$@. Files with different content are moved to the Trash first. Files that aren’t in the backup are left as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se descarga el backup a la carpeta de destino. Los archivos de %1$@ se copiarán en %2$@. Los archivos con contenido distinto se moverán antes a la Papelera. Los archivos que no estén en el backup no se tocan."
          }
        }
      }
    },
    "The destination folder isn’t empty. Choose another location.": {
